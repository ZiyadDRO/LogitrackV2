# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets. The Groq key used to be hardcoded in src/lib/ai.js and GitHub's push
# protection blocked the commit carrying it (GH013). It lives in .env.local now.
# `*.local` above already covers .env.local; these make the intent explicit and
# catch the other shapes. .env.local.example IS committed — it holds no key.
.env
.env.*
!.env.local.example

# Python
__pycache__/
*.pyc
.venv
venv/

# Runtime state
model_switches.json
# Sealed forecast history. Unrecoverable if lost (see forecast_log.py) — this
# ignores it in git, it does NOT delete it. Keep the local copy; back it up
# separately if it matters. Never commit: it's live data, not source.
engine_statsforecast/forecast_log.json

# Test-run artifacts. Inspect dumps + preview PNGs from dataset builds.
outputs/
*.inspect.ndjson
inspect_errors.ndjson

# Test catalogues stay out of the repo — they're data, not source.
# Regenerate the two documented ones with the seeded builders in test_data/:
#   python build_catalogue_v2.py    -> logitrack_catalogue_v2.xlsx  (32 SKUs)
#   python build_master_dataset.py  -> logitrack_master_test.xlsx   (24 SKUs)
# Drop your own catalogues in test_data/ freely; they won't be committed.
# The small .csv fixtures ARE committed — they test malformed/short input.
test_data/*.xlsx

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
backtest_tiers.json
backtest_last_result.json

# Persisted app state — your store's sales history and the last backtest.
# Data, not code: it is rebuilt from an upload or a sync, and must never be committed.
engine_statsforecast/catalog_store/
engine_statsforecast/backtest_store/
# Stores or spreadsheets set aside while another is showing (can hold real sales)
engine_statsforecast/workspaces/
# Hourly inventory readings. Runtime state like the forecast log above, not code.
engine_statsforecast/stock_log.json

# When the nightly sync last ran. Runtime state, not code — losing it costs one
# redundant sync, committing it would make every clone think it synced on your machine.
engine_statsforecast/sync_state.json
engine_statsforecast/sync_state.json.tmp
# Which days this install's store is closed. Runtime settings, like the sync ledger.
engine_statsforecast/closed_days.json
engine_statsforecast/closed_days.json.tmp

# Saved store logins. Holds the Square / Shopify ACCESS TOKEN in plain text: committing it
# published a live Square token in a public repo, and made every fresh clone show the
# store as "connected" with nothing loaded. Each install connects once from the app.
engine_statsforecast/connections.json
engine_statsforecast/connections.json.tmp
# Today's sales and the shelf prices last read from the store. Runtime state.
engine_statsforecast/today_sales.json
engine_statsforecast/today_sales.json.tmp
engine_statsforecast/live_prices.json
engine_statsforecast/live_prices.json.tmp
